# PulseOps Configuration

# LLM Provider Configuration
# Set LLM_MODE to "mock" for completely offline/deterministic local execution and testing (no API key required)
# Set LLM_MODE to "openrouter" or "openai" for live LLM execution
LLM_MODE=mock

# OpenRouter API Key (required only if LLM_MODE=openrouter)
OPENROUTER_API_KEY="
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Preferred default free model on OpenRouter:
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Alternative fallback free models:
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Custom Base URL (optional, defaults to https://openrouter.ai/api/v1 for openrouter)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI Configuration (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./pulseops.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
